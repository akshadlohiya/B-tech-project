  "ranging": {
    "mode": "DS-TWR",
    "updateRateHz": 5,
    "sequentialPerAnchor": true,
    "speedOfLightMps": 299702547,
    "assumedTagHeightM": 0.6,
    "kalman": {
      "processNoiseStd": 2.0,
      "measurementNoiseStd": 0.5
    },
    "note": "DS-TWR (double-sided two-way ranging) is what the MaUWB_DW3000 firmware performs; it cancels device clock drift, so no time synchronisation between anchors is required (see Project Diary, 01-04 Apr 2026). Values below are tuned to typical DW3000 behaviour and should be re-tuned against real hardware (provenance: guessed).",
    "losNoiseStdM": 0.054,
    "nlosNoiseStdM": 0.054,
    "nlosBiasMinM": 0.026,
    "nlosBiasMaxM": 0.399,
    "maxRangeM": 60,
    "dropProbLos": 0.01,
    "dropProbNlos": 0.15,
    "power": {
      "rxPowerLosDbm": -80,
      "rxPowerPerMeterDbm": -0.9,
      "nlosRxDropDbm": -12,
      "fpToRxDeltaLosDbm": -3,
      "nlosFpExtraAttenDbm": -10,
      "note": "DW3000 exposes received-signal-power and first-path-power registers. A large (rxPower - fpPower) gap indicates the first path was attenuated -> likely NLOS. This is the diagnostic the solver uses to down-weight NLOS ranges (see item list Note 4)."
    },
    "provenance": "calibrated:UTIL-IJRR2024",
    "calibrationNote": "Range-noise model calibrated from the UTIL identification-dataset (DWM1000, LOS + obstructing-material NLOS). sigma_range = sigma_tdoa/sqrt(2). Power (dBm) block left as a DW3000 abstraction: UTIL power_dif units are cross-radio and do not map directly (recalibrate on DW3000 hardware).",
